{% extends 'base.html.twig' %}

{% block title %}Accueil - WatchSide Galactic{% endblock %}

{% block body %}
{# Hero Section #}
<section class="d-flex align-items-center justify-content-center vh-100 position-relative text-center p-3 animate-fade-in">
    <div class="position-relative z-1">
        <h1 class="display-1 text-hologram fw-bold mb-4" style="text-shadow: 0 0 20px rgba(78, 204, 163, 0.5);">
            RENTEZ VOTRE<br>PROCHAINE AVENTURE
        </h1>
        <p class="lead text-starlight mb-5 fs-3" style="font-family: 'Exo 2';">
            Explorez les confins du cinéma. Louez. Regardez. Voyagez.
        </p>
        <a href="{{ path('app_film_index') }}" class="btn btn-galactic btn-lg px-5 py-3 rounded-pill fs-4">
            <i class="bi bi-rocket-takeoff me-2"></i> EXPLORER LA GALAXIE
        </a>
    </div>
</section>

{# Featured Section #}
<section class="container py-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h2 class="display-4 text-hologram border-bottom border-secondary d-inline-block pb-2">
                FORCES EN PRÉSENCE
            </h2>
        </div>
    </div>

    <div class="row g-4">
        {% for film in films %}
            <div class="col-md-4">
                <div class="card card-movie h-100 text-white">
                    <div class="position-relative overflow-hidden" style="height: 400px;">
                        <a href="{{ path('app_film_show', {'id': film.id}) }}" class="d-block h-100 w-100 text-decoration-none">
                            {% if film.image %}
                                <img src="{{ film.image }}" class="card-img-top h-100 w-100 object-fit-cover" alt="{{ film.titre }}">
                            {% else %}
                                <div class="d-flex align-items-center justify-content-center h-100 bg-dark text-muted">
                                    <i class="bi bi-film display-1"></i>
                                </div>
                            {% endif %}
                        </a>
                        <div class="position-absolute bottom-0 start-0 w-100 p-3 pointer-events-none" style="background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);">
                            <h5 class="card-title text-hologram mb-0">{{ film.titre }}</h5>
                        </div>
                    </div>
                
                    <div class="card-body glass-panel border-top-0 rounded-0 rounded-bottom d-flex flex-column">
                        <p class="card-text text-truncate text-muted small mb-3">
                            {{ film.synopsis }}
                        </p>
                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="badge bg-transparent border border-secondary text-light">
                                {{ film.anneSortie ? film.anneSortie|date('Y') : 'N/A' }}
                            </span>
                            <a href="{{ path('app_film_show', {'id': film.id}) }}" class="btn btn-sm btn-galactic">
                                Voir la fiche
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center text-muted">
                <p>Aucun film trouvé dans la base de données galactique.</p>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}
