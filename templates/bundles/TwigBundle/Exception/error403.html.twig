{% extends 'base.html.twig' %}

{% block title %}Accès Refusé - WatchSide Galactic{% endblock %}

{% block body %}
<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="glass-panel p-5 text-center animate-fade-in" style="max-width: 600px;">
        <div class="display-1 text-danger fw-bold mb-3">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1 class="display-4 text-hologram fw-bold mb-4">ACCÈS INTERDIT</h1>
        
        <p class="lead text-light mb-4">
            <strong class="text-danger">Erreur 403</strong> : Vos codes d'accréditation sont insuffisants pour accéder à ce secteur de la base de données.
        </p>
        
        <p class="text-secondary mb-5">
            Cette tentative a été enregistrée par les droïdes de sécurité. Veuillez retourner en zone autorisée immédiatement.
        </p>

        <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
            <a href="{{ path('app_home') }}" class="btn btn-galactic btn-lg px-4 gap-3">
                <i class="bi bi-house-door me-2"></i> Retour à l'accueil
            </a>
            {% if app.user %}
                <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-lg px-4">
                    <i class="bi bi-box-arrow-right me-2"></i> Changer de compte
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-lg px-4">
                    <i class="bi bi-person-badge me-2"></i> Connexion
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
