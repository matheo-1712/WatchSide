{% extends 'base.html.twig' %}

{% block title %}Recrutement Impérial - WatchSide Galactic{% endblock %}

{% block body %}
{# Lightsaber Background #}
<div class="sith-bg position-fixed top-0 start-0 w-100 h-100 z-0">
    <div class="lightsaber-container">
        <div class="saber saber-red"></div>
        <div class="saber saber-green"></div>
    </div>
    {# Red Fog Overlay #}
    <div class="position-absolute w-100 h-100" style="background: radial-gradient(circle, transparent 0%, #000 90%);"></div>
</div>

<div class="container d-flex justify-content-center align-items-center flex-grow-1 position-relative z-1" style="min-height: 85vh;">
    <div class="col-md-6 col-lg-5">
        <div class="cockpit-panel sith-panel p-5 rounded-3 text-center">
            
            <div class="mb-4">
                <i class="bi bi-person-fill-slash display-2 text-sith animate-pulse"></i>
                <h1 class="h3 mt-3 text-uppercase text-sith fw-bold" style="letter-spacing: 2px;">REJOIGNEZ LE CÔTÉ OBSCUR</h1>
                <p class="text-secondary small fst-italic mt-2">
                    "Je trouve votre manque de foi consternant..."
                </p>
            </div>

            <div class="alert alert-dark bg-transparent border-sith text-sith mb-4 small text-start">
                <i class="bi bi-exclamation-octagon-fill me-2"></i> 
                <strong>Ordre Impérial 66 :</strong> 
                Lord Vador exige votre inscription immédiate. Toute résistance sera futile et sévèrement punie.
            </div>

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}
                <div class="form-floating mb-3 text-start">
                    {{ form_widget(registrationForm.nom_utilisateur, {'attr': {'class': 'form-control cockpit-input sith-input', 'placeholder': 'Identifiant'}}) }}
                    <label for="{{ registrationForm.nom_utilisateur.vars.id }}" class="text-sith">Identifiant Rebelle</label>
                </div>

                <div class="form-floating mb-3 text-start">
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control cockpit-input sith-input', 'placeholder': 'Mot de passe'}}) }}
                    <label for="{{ registrationForm.plainPassword.vars.id }}" class="text-sith">Code de Sécurité</label>
                </div>

                <div class="form-check text-start mb-4">
                     {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input bg-dark border-sith'}}) }}
                     <label class="form-check-label text-muted small" for="{{ registrationForm.agreeTerms.vars.id }}">
                        J'accepte de servir l'Empire Galactique éternellement.
                    </label>
                </div>

                <button type="submit" class="btn btn-sith btn-lg w-100 py-3 fw-bold">
                    <i class="bi bi-lightning-charge-fill me-2"></i> SOUMETTRE MA VOLONTÉ
                </button>
            {{ form_end(registrationForm) }}

            <div class="mt-4 pt-3 border-top border-secondary">
                 <p class="small text-muted mb-0">
                    Déjà serviteur de l'Empire ? <a href="{{ path('app_login') }}" class="text-sith text-decoration-none fw-bold">Rapportez-vous au poste de commande</a>.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
