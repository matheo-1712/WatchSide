{% extends 'base.html.twig' %}

{% block title %}Edit Film{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card bg-dark text-light border-secondary shadow-lg">
                    <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
                        <h1 class="h3 mb-0">✏️ Modifier le film</h1>
                    </div>
                    <div class="card-body">
                        {{ include('film/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                    </div>
                    <div class="card-footer border-secondary bg-transparent d-flex justify-content-between align-items-center">
                        <a href="{{ path('app_film_index') }}" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-arrow-left"></i> Retour
                        </a>
                        {{ include('film/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
