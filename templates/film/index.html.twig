{% extends 'base.html.twig' %}

{% block title %}Catalogue - WatchSide Galactic{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="text-hologram display-5 fw-bold">CATALOGUE GALACTIQUE</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_film_new') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-plus-lg"></i> Ajouter un film
            </a>
        {% endif %}
    </div>

    {# Filter/Search Placeholder #}
    <div class="glass-panel p-4 mb-5">
        <div class="row g-3 align-items-center">
            <div class="col-12">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary text-light w-85">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control" placeholder="Rechercher un film..."
                           style="color: white;"
                           aria-label="Search">
                </div>
            </div>
            <div class="col-md-auto ms-auto">
                <div class=" small">
                    <i class="bi bi-funnel"></i> Total: {{ films|length }} films
                </div>
            </div>
        </div>
    </div>
    <style>
        .form-control::placeholder {
            color: white !important;
            opacity: 1;
        }

        .form-control::-webkit-input-placeholder {
            color: white !important;
        }

        .form-control::-moz-placeholder {
            color: white !important;
            opacity: 1;
        }

        .form-control:-ms-input-placeholder {
            color: white !important;
        }

        .form-control::-ms-input-placeholder {
            color: white !important;
        }
    </style>

    <div class="row g-4">
        {% for film in films %}
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card card-movie h-100 text-white shadow-lg">
                    <div class="position-relative" style="height: 350px; overflow: hidden;">
                        <a href="{{ path('app_film_show', {'id': film.id}) }}" class="d-block h-100 w-100 text-decoration-none">
                            {% if film.image %}
                                <img src="{{ film.image }}" class="card-img-top h-100 w-100 object-fit-cover" alt="{{ film.titre }}">
                            {% else %}
                                <div class="d-flex align-items-center justify-content-center h-100 bg-dark">
                                    <i class="bi bi-film display-1"></i>
                                </div>
                            {% endif %}
                        </a>
                        <div class="position-absolute top-0 end-0 p-2 pointer-events-none">
                             <span class="badge bg-dark border border-secondary">{{ film.duree ? film.duree ~ ' min' : 'N/A' }}</span>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column glass-panel border-top-0 rounded-0 rounded-bottom">
                        <a href="{{ path('app_film_show', {'id': film.id}) }}"
                           class="d-block h-100 w-100 text-decoration-none text-white">
                            <h5 class="card-title text-white text-truncate mb-2">{{ film.titre }}</h5>
                            <p class="small mb-3 flex-grow-1 text-white">
                                {{ film.synopsis|slice(0, 60) }}...
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="text-white fw-bold">
                                    {{ film.prixDefault ? film.prixDefault ~ ' €' : 'Gratuit' }}
                                </span>
                                <div class="btn-group">
                                    <a href="{{ path('app_film_show', {'id': film.id}) }}"
                                       class="btn btn-sm btn-galactic">
                                        Louer
                                    </a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('app_film_edit', {'id': film.id}) }}"
                                           class="btn btn-sm btn-outline-secondary border-0">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <h3 >Aucune transmission reçue...</h3>
                <p class="text-secondary">Essayez d'ajuster vos senseurs longue portée (filtres).</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
