{% extends 'base.html.twig' %}

{% block title %}Catalogue - WatchSide Galactic{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="text-hologram display-5 fw-bold">CATALOGUE GALACTIQUE</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_film_new') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-plus-lg"></i> Ajouter un film
            </a>
        {% endif %}
    </div>

    {# Filter/Search Placeholder #}
    <div class="glass-panel p-4 mb-5">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-8">
                <form method="get" action="{{ path('film_recherche') }}" class="w-100">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-transparent border-secondary text-light">
                            <i class="bi bi-search"></i>
                        </span>
                        <input
                            name="q"
                            type="text"
                            class="form-control border-secondary text-light bg-transparent"
                            placeholder="Rechercher un film..."
                            value="{{ app.request.get('q') }}"
                        >
                        {% if app.request.get('q') %}
                            <a href="{{ path('film_recherche') }}" class="btn btn-outline-secondary border-start-0 text-white" title="Effacer la recherche">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# Define Favorites Section #}
    {% set favorites_section %}
        {% if app.user and favoris is not empty %}
            <div class="mb-5">
                <h2 class="mb-4">⭐ Mes favoris</h2>
                <div class="row g-4">
                    {% for favori in favoris %}
                        <div class="col-sm-6 col-md-4 col-lg-3">
                            {% include 'film/_card.html.twig' with { film: favori.idFilm } %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    {% endset %}

    {# Define Results Section #}
    {% set results_section %}
        <div class="mb-5">
            <h2 class="mb-4">
                {% if app.request.get('q') %}
                    Résultats pour « {{ app.request.get('q') }} »
                {% else %}
                    Les films
                {% endif %}
            </h2>

            <div class="row g-4">
                {% for film in films %}
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        {% include 'film/_card.html.twig' with { film: film } %}
                    </div>
                {% else %}
                    <p>Aucun film trouvé</p>
                {% endfor %}
            </div>
        </div>
    {% endset %}

    {# Ordre de requete en fonction du compte et de la recherche #}
    {% if app.request.get('q') %}
        {{ results_section }}
        {{ favorites_section }}
    {% else %}
        {{ favorites_section }}
        {{ results_section }}
    {% endif %}

</div>

    {# Style #}
    <style>
        .form-control::placeholder {
            color: white !important;
            opacity: 1;
        }

        .form-control::-webkit-input-placeholder {
            color: white !important;
        }

        .form-control::-moz-placeholder {
            color: white !important;
            opacity: 1;
        }

        .form-control:-ms-input-placeholder {
            color: white !important;
        }

        .form-control::-ms-input-placeholder {
            color: white !important;
        }
    </style>

{% endblock %}
