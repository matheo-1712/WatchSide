<div class="row g-4">
            <div class="card card-movie h-100 text-white shadow-lg">
                <div class="position-relative" style="height: 350px; overflow: hidden;">
                    <a href="{{ path('app_film_show', {'id': film.id}) }}" class="d-block h-100 w-100 text-decoration-none">
                        {% if film.image %}
                            <img src="{{ film.image }}" class="card-img-top h-100 w-100 object-fit-cover" alt="{{ film.titre }}">
                        {% else %}
                            <div class="d-flex align-items-center justify-content-center h-100 bg-dark">
                                <i class="bi bi-film display-1"></i>
                            </div>
                        {% endif %}
                    </a>
                    <div class="position-absolute top-0 end-0 p-2 pointer-events-none">
                        <span class="badge bg-dark border border-secondary">{{ film.duree ? film.duree ~ ' min' : 'N/A' }}</span>
                    </div>
                </div>


                <div class="card-body d-flex flex-column glass-panel border-top-0 rounded-0 rounded-bottom">
                    <a href="{{ path('app_film_show', {'id': film.id}) }}"
                       class="d-block h-100 w-100 text-decoration-none text-white">
                        <h5 class="card-title text-white text-truncate mb-2">{{ film.titre }}</h5>
                        <p class="small mb-3 flex-grow-1 text-white">
                            {{ film.synopsis|slice(0, 60) }}...
                        </p>


                        <div class="d-flex justify-content-between align-items-center mt-3">
                           <span class="text-white fw-bold">
                               {{ film.prixDefault ? film.prixDefault ~ ' €' : 'Gratuit' }}
                           </span>
                            <div class="btn-group">
                                <a href="{{ path('app_location_new', {'id': film.id}) }}"
                                   class="btn btn-sm btn-galactic">
                                    Louer
                                </a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_film_edit', {'id': film.id}) }}"
                                       class="btn btn-sm btn-outline-secondary border-0">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                </div>
            </div>
</div>

