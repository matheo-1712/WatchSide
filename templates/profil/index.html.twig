{% extends 'base.html.twig' %}

{% block title %}Profil Pilote - WatchSide{% endblock %}

{% block body %}
<div class="container py-5">
    {# Header Section #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="cockpit-panel p-4 rounded-3 d-flex align-items-center">
                <div>
                    <h1 class="display-5 text-hologram fw-bold mb-0">{{ user.nomUtilisateur }}</h1>
                    <p class="text-secondary mb-0">Matricule: #{{ user.id|format_number({min_integer_digit: 4, grouping_used:false}) }}</p>
                    <span class="badge bg-transparent border border-info text-info rounded-pill mt-2">
                        <i class="bi bi-star-fill me-1"></i> Pilote Confirmé
                    </span>
                </div>
            </div>
        </div>
    </div>

    {# Stats Grid #}
    <div class="row g-4 mb-4">
        {# Rentals Stat #}
        <div class="col-md-6 col-lg-4">
            <div class="cockpit-panel p-3 rounded-3 text-center h-100 d-flex flex-column justify-content-center">
                <i class="bi bi-ticket-perforated-fill display-4 text-warning mb-2"></i>
                <h3 class="h2 text-white fw-bold mb-0">{{ user.locations|length }}</h3>
                <p class="text-secondary small text-uppercase">Locations Actives</p>
            </div>
        </div>
        {# Favorites Stat #}
        <div class="col-md-6 col-lg-4">
             <div class="cockpit-panel p-3 rounded-3 text-center h-100 d-flex flex-column justify-content-center">
                <i class="bi bi-heart-fill display-4 text-danger mb-2"></i>
                <h3 class="h2 text-white fw-bold mb-0">{{ user.favoris|length }}</h3>
                <p class="text-secondary small text-uppercase">Favoris</p>
            </div>
        </div>
        {# Reviews Stat #}
        <div class="col-md-6 col-lg-4">
             <div class="cockpit-panel p-3 rounded-3 text-center h-100 d-flex flex-column justify-content-center">
                <i class="bi bi-chat-square-quote-fill display-4 text-primary mb-2"></i>
                <h3 class="h2 text-white fw-bold mb-0">{{ user.notes|length }}</h3>
                <p class="text-secondary small text-uppercase">Notes Donnés</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        {# My Rentals Section #}
        <div class="col-lg-8">
            <div class="cockpit-panel p-4 rounded-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-2">
                    <h2 class="h4 text-hologram mb-0"><i class="bi bi-collection-play me-2"></i>Mes Locations</h2>
                    <a href="{{ path('app_film_index') }}" class="btn btn-sm btn-outline-info">Nouvelle Mission</a>
                </div>

                {% if user.locations is empty %}
                    <div class="text-center py-5">
                        <i class="bi bi-disc text-secondary display-1 opacity-25"></i>
                        <p class="text-muted mt-3">Aucune mission en cours.</p>
                    </div>
                {% else %}
                    <div class="list-group list-group-flush bg-transparent">
                        {% for location in user.locations %}
                            <div class="list-group-item bg-transparent text-white border-secondary d-flex justify-content-between align-items-center px-0">
                                <div class="d-flex align-items-center">
                                    <div class="rounded bg-secondary d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                        <i class="bi bi-film fs-4"></i>
                                    </div>
                                    <div>
                                        {# Accessing relationship via idFilm getter #}
                                        <h5 class="mb-0">{{ location.idFilm.titre }}</h5>
                                        <small class="text-muted">Loué le {{ location.dateDebut|date('d/m/Y') }}</small>
                                    </div>
                                </div>
                                <span class="badge bg-warning text-dark">En cours</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        {# My Favorites Section #}
        <div class="col-lg-4">
            <div class="cockpit-panel p-4 rounded-3 h-100">
                <h2 class="h4 text-hologram mb-4 border-bottom border-secondary pb-2"><i class="bi bi-bookmarks me-2"></i>Favoris</h2>

                {% if user.favoris is empty %}
                     <p class="text-muted text-center my-5">Votre liste est vide.</p>
                {% else %}
                    <div class="d-grid gap-2">
                        {% for favori in user.favoris %}
                            <div class="card bg-dark border-secondary text-white">
                                <div class="card-body p-2 d-flex align-items-center">
                                     <i class="bi bi-heart-fill text-danger me-3"></i>
                                     <span class="text-truncate">{{ favori.idFilm.titre }}</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
