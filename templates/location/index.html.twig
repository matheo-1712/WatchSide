{% extends 'base.html.twig' %}

{% block title %}Mes Locations - WatchSide Galactic{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold text-hologram">JOURNAL DES MISSIONS</h1>
             <p class="lead">Suivi de vos contrats de location actifs et passés.</p>
        </div>
    </div>

    <div class="glass-panel p-4">
        {% if locations|length > 0 %}
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                    <thead>
                        <tr class="text-uppercase text-secondary small border-bottom border-secondary">
                            <th scope="col" class="py-3">ID</th>
                            {% if is_granted('ROLE_ADMIN') %}
                                <th scope="col" class="py-3">Pilote</th>
                            {% endif %}
                            <th scope="col" class="py-3">Film</th>
                            <th scope="col" class="py-3">Début</th>
                            <th scope="col" class="py-3">Fin</th>
                            <th scope="col" class="py-3 text-end">État / Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for location in locations %}
                        <tr class="border-bottom border-secondary" style="border-bottom-color: rgba(255,255,255,0.1) !important;">
                            <td class="fw-bold text-hologram">#{{ location.id }}</td>

                            {% if is_granted('ROLE_ADMIN') %}
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px; font-size: 0.8rem;">
                                            {{ location.idUser.nomUtilisateur|slice(0,2)|upper }}
                                        </div>
                                        <span>{{ location.idUser.nomUtilisateur }}</span>
                                    </div>
                                </td>
                            {% endif %}

                            <td>
                                <div class="d-flex align-items-center">
                                    {% if location.idFilm.image %}
                                        <img src="{{ location.idFilm.image }}" class="rounded me-2 object-fit-cover" style="width: 40px; height: 60px;" alt="Poster">
                                    {% else %}
                                        <div class="rounded bg-secondary d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 60px;">
                                            <i class="bi bi-film"></i>
                                        </div>
                                    {% endif %}
                                    <span class="fw-bold text-light">{{ location.idFilm.titre }}</span>
                                </div>
                            </td>

                            <td> {{ location.dateDebut ? location.dateDebut|date('d/m/Y') : '-' }} </td>
                            <td>{{ location.dateFin ? location.dateFin|date('d/m/Y') : '-' }}</td>

                            <td class="text-end">
                                {% if is_granted('ROLE_ADMIN') %}
                                     <a href="{{ path('app_location_edit', {'id': location.id}) }}" class="btn btn-sm btn-outline-info border-0 me-1" title="Modifier">
                                       Modifier
                                    </a>
                                    <form method="post" action="{{ path('app_location_delete', {'id': location.id}) }}" onsubmit="return confirm('Supprimer cette location ?');" class="d-inline-block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.id) }}">
                                        <button class="btn btn-sm btn-outline-danger border-0" title="Supprimer">
                                            Supprimer
                                        </button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
             <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-secondary mb-3"></i>
                <h3>Aucune mission en cours.</h3>
                <a href="{{ path('app_film_index') }}" class="btn btn-galactic mt-3">Explorer le catalogue</a>
            </div>
        {% endif %}
    </div>

    <div class="mt-4 text-center">
        <a href="{{ path('app_location_new') }}" class="btn btn-outline-secondary">
            <i class="bi bi-plus-circle me-2"></i> Initier une nouvelle location</a>
    </div>
</div>
{% endblock %}
