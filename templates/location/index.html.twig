{% extends 'base.html.twig' %}

{% block title %}Mes Locations - WatchSide Galactic{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold text-hologram">JOURNAL DES MISSIONS</h1>
             <p class="lead">Suivi de vos contrats de location actifs et passés.</p>
        </div>
    </div>

    <div class="glass-panel p-4">
        {% if locations|length > 0 %}
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                    <thead>
                        <tr class="text-uppercase text-secondary small border-bottom border-secondary">
                            <th scope="col" class="py-3">ID Contrat</th>
                            <th scope="col" class="py-3">Début de mission</th>
                            <th scope="col" class="py-3">Fin prévue</th>
                            <th scope="col" class="py-3 text-end">État / Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for location in locations %}
                        <tr class="border-bottom border-secondary" style="border-bottom-color: rgba(255,255,255,0.1) !important;">
                            <td class="fw-bold text-hologram">#{{ location.id }}</td>
                            <td> {{ location.dateDebut ? location.dateDebut|date('d/m/Y') : '-' }} </td>
                            <td>{{ location.dateFin ? location.dateFin|date('d/m/Y') : '-' }}</td>
                            <td class="text-end">
                                <a href="{{ path('app_location_show', {'id': location.id}) }}" class="btn btn-sm btn-outline-light rounded-pill px-3">
                                    <i class="bi bi-eye"></i> Détails
                                </a>
                                {% if is_granted('ROLE_ADMIN') %}
                                     <a href="{{ path('app_location_edit', {'id': location.id}) }}" class="btn btn-sm btn-dark text-sith border-0">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
             <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-secondary mb-3"></i>
                <h3>Aucune mission en cours.</h3>
                <a href="{{ path('app_film_index') }}" class="btn btn-galactic mt-3">Explorer le catalogue</a>
            </div>
        {% endif %}
    </div>

    <div class="mt-4 text-center">
        <a href="{{ path('app_location_new') }}" class="btn btn-outline-secondary">
            <i class="bi bi-plus-circle me-2"></i> Initier une nouvelle location</a>
    </div>
</div>
{% endblock %}
