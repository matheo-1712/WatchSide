<style>
    .form-label {
        color: #adbac7; /* Text secondary color */
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
    }
    
    /* Fix for ugly options in dropdowns */
    select.form-select option {
        background-color: #1a1a1a;
        color: white;
        padding: 10px;
    }
</style>

{{ form_start(form) }}
    <div class="row g-4">
        {% if form.id_film is defined %}
            <div class="col-12">
                {{ form_row(form.id_film) }}
            </div>
        {% endif %}
        
        <div class="col-md-6">
            {{ form_row(form.date_debut) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.date_fin) }}
        </div>
    </div>
    
    <div class="mt-5">
        <button class="btn btn-galactic btn-lg w-100 py-3 position-relative overflow-hidden group">
            <span class="position-relative z-1">
                <i class="bi bi-check2-circle me-2"></i> {{ button_label|default('Confirmer la location') }}
            </span>
        </button>
    </div>
{{ form_end(form) }}
